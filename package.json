{
  "name": "storecraft",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @storecraft/web",
    "dev:api": "npm run dev -w @storecraft/api",
